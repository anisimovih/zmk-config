#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp ESCAPE      &kp Q  &kp W     &kp E         &kp R        &kp T                 &kp Y                &kp U        &kp I            &kp O       &kp P     &kp BACKSPACE        &kp BACKSLASH
           &kp LEFT_SHIFT  &kp A  &kp S     &kp D         &kp F        &kp G                 &kp H                &kp J        &kp K            &kp L       &kp SEMI  &mt RIGHT_SHIFT SQT
           &mt LCTRL TAB   &kp Z  &kp X     &kp C         &kp V        &kp B                 &kp N                &kp M        &kp COMMA        &kp DOT     &kp FSLH  &mt RCTRL BSLH
                                  &kp LGUI  &kp LEFT_ALT  &lt 1 SPACE  &lt 2 LEFT_BRACKET    &lt 2 RIGHT_BRACKET  &lt 1 ENTER  &kp RIGHT_SHIFT  &kp DELETE
            >;
        };

        symbol_layer {
            bindings = <
&none  &none           &kp F1     &kp F2    &kp F3                &kp F4            &kp F5            &kp F6           &kp F7             &kp F8                 &kp F9                &kp F10    &kp F11               &kp F12
       &kp LEFT_SHIFT  &kp MINUS  &kp PLUS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp UNDER             &kp EQUAL  &mt RIGHT_SHIFT CAPS
       &kp LCTRL       &kp EXCL   &kp AT    &kp HASH              &kp DLLR          &kp PRCNT         &kp CARET        &kp AMPS           &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp N0     &kp RCTRL
                                  &trans    &none                 &to 1             &trans            &trans           &to 1              &none                  &trans
            >;
        };

        navigation_layer {
            bindings = <
&trans  &none  &none     &trans          &kp UP_ARROW    &kp PAGE_UP      &none      &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE  &none  &none
        &none  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END    &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS    &none
        &none  &none     &none           &none           &kp PAGE_DOWN    &none      &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_COMMA   &none
                         &to 4           &none           &none            &to 0      &to 0            &none            &none            &to 3
            >;
        };

        control_layer {
            bindings = <
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };

        game_layer {
            bindings = <
&kp GRAVE  &kp T  &kp ESC    &kp Q   &kp W      &kp E      &kp R     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT  &kp RBKT
           &kp G  &kp LSHFT  &kp A   &kp S      &kp D      &kp F     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
           &kp B  &kp LCTRL  &kp Z   &kp X      &kp C      &kp V     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                             &kp N1  &kp SPACE  &kp ENTER  &kp N2    &kp N3  &kp N4  &kp N5     &kp N6
            >;
        };
    };
};
