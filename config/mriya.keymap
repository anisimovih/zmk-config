#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp ESCAPE      &kp Q  &kp W             &kp E        &kp R               &kp T           &kp Y                     &kp U                &kp I        &kp O       &kp P     &kp BACKSPACE        &kp BACKSLASH
           &kp LEFT_SHIFT  &kp A  &kp S             &kp D        &kp F               &kp G           &kp H                     &kp J                &kp K        &kp L       &kp SEMI  &mt RIGHT_SHIFT SQT
           &mt LCTRL TAB   &kp Z  &kp X             &kp C        &kp V               &kp B           &kp N                     &kp M                &kp COMMA    &kp DOT     &kp FSLH  &mt RCTRL BSLH
                                  &mt LEFT_WIN TAB  &lt 1 SPACE  &lt 2 LEFT_BRACKET  &kp LEFT_ALT    &mt LEFT_SHIFT LG(SPACE)  &lt 2 RIGHT_BRACKET  &lt 1 ENTER  &kp DELETE
            >;
        };

        symbol_layer {
            bindings = <
&none  &none           &kp F1     &kp F2    &kp F3            &kp F4                &kp F5            &kp F6           &kp F7                 &kp F8             &kp F9     &kp F10        &kp F11               &kp F12
       &kp LEFT_SHIFT  &kp MINUS  &kp PLUS  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp UNDER  &kp EQUAL      &mt RIGHT_SHIFT CAPS
       &kp LCTRL       &kp EXCL   &kp AT    &kp HASH          &kp DLLR              &kp PRCNT         &kp CARET        &kp AMPS               &kp ASTERISK       &kp PIPE   &kp BACKSLASH  &kp RCTRL
                                  &trans    &kp SPACE         &trans                &trans            &trans           &trans                 &trans             &trans
            >;
        };

        navigation_layer {
            bindings = <
&trans  &none  &none     &trans          &kp UP_ARROW    &kp PAGE_UP      &kp INSERT    &kp ASTERISK  &kp N7        &kp N8  &kp N9  &kp FSLH  &kp BACKSPACE          &kp COMMA
        &none  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END       &kp MINUS     &kp N4        &kp N5  &kp N6  &kp PLUS  &kp LEFT_PARENTHESIS
        &none  &none     &none           &none           &kp PAGE_DOWN    &none         &kp NUMBER_0  &kp NUMBER_1  &kp N2  &kp N3  &kp DOT   &kp RIGHT_PARENTHESIS
                         &to 4           &none           &trans           &to 0         &to 0         &trans        &trans  &to 3
            >;
        };

        control_layer {
            bindings = <
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans
            >;
        };

        game_layer {
            bindings = <
&kp GRAVE  &kp ESC     &kp ESC    &kp Q  &kp W      &kp E      &kp R    &kp Y  &kp U  &kp I      &kp O    &kp P     &kp LBKT  &kp RBKT
           &kp LSHIFT  &kp LSHFT  &kp A  &kp S      &kp D      &kp F    &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp APOS
           &kp LCTRL   &kp LCTRL  &kp Z  &kp X      &kp C      &kp V    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                                  &kp I  &kp SPACE  &kp ENTER  &kp M    &to 0  &kp T  &kp G      &kp B
            >;
        };
    };
};
